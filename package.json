{
  "name": "@iamgeorgekelly/commerce-evidence-toolkit",
  "version": "0.1.0",
  "description": "Local evidence checks for product records, feed snapshots, and product dimensions. No accounts, network calls, or feed writes.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "George Kelly",
  "homepage": "https://www.iamgeorgekelly.com/for-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamgeorgekelly/agentic-commerce-field-guide.git"
  },
  "bugs": {
    "url": "https://github.com/iamgeorgekelly/agentic-commerce-field-guide/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "commerce-evidence-mcp": "server/index.mjs"
  },
  "exports": {
    ".": "./server/tools.mjs"
  },
  "files": [
    "server/",
    "artifacts/",
    "examples/",
    "provenance.json",
    "CITATION.cff",
    "LICENSE*",
    "README.md"
  ],
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "bundle": "node scripts/build-bundle.mjs"
  },
  "keywords": [
    "mcp",
    "agentic-commerce",
    "product-data",
    "feed-quality",
    "dimension-conversion"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  }
}
